{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "blocked"
      ],
      "default": "pending"
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "email",
    "status"
  ]
}