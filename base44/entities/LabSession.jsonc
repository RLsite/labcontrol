{
  "name": "LabSession",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string"
    },
    "device_name": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "ended"
      ],
      "default": "active"
    },
    "purpose": {
      "type": "string"
    }
  },
  "required": [
    "device_id",
    "device_name",
    "user_email",
    "start_time",
    "status"
  ]
}