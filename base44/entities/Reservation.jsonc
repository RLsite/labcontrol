{
  "name": "Reservation",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string"
    },
    "device_name": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "purpose": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "active",
        "completed",
        "cancelled"
      ],
      "default": "upcoming"
    },
    "lab_id": {
      "type": "string"
    }
  },
  "required": [
    "device_id",
    "device_name",
    "user_email",
    "start_time",
    "end_time",
    "status",
    "lab_id"
  ]
}